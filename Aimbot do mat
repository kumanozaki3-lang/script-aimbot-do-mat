local circleTweenInfo = TweenInfo.new(
    0.5,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

-- Variável de estado
local isActive = false
local currentCircle = nil

-- Função para criar animação de clique do botão
local function animateButton(button)
    local originalSize = button.Size
    local tweenService = game:GetService("TweenService")
    
    local pressTween = tweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 5, originalSize.Y.Scale, originalSize.Y.Offset - 5)
    })
    
    local releaseTween = tweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = originalSize
    })
    
    pressTween:Play()
    pressTween.Completed:Connect(function()
        releaseTween:Play()
    end)
end

-- Função para atualizar indicador de status
local function updateStatus(active)
    local tweenService = game:GetService("TweenService")
    
    if active then
        statusText.Text = "Ativado"
        statusDot.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
        statusDot.BackgroundTransparency = 0
        
        -- Animação do status dot
        local pulseTween = tweenService:Create(statusDot, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
            BackgroundTransparency = 0.5
        })
        pulseTween:Play()
        
        aimbotButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        buttonStroke.Transparency = 0.3
    else
        statusText.Text = "Desativado"
        statusDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        statusDot.BackgroundTransparency = 0
        aimbotButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        buttonStroke.Transparency = 0.8
    end
end

-- Função para mostrar/esconder círculo com animação
local function toggleCircle(show)
    local tweenService = game:GetService("TweenService")
    
    if show then
        detectionCircle.Visible = true
        detectionCircle.BackgroundTransparency = 1
        
        local appearTween = tweenService:Create(detectionCircle, circleTweenInfo, {
            Size = UDim2.new(0, 150, 0, 150)
        })
        
        local fadeTween = tweenService:Create(circleBorder, circleTweenInfo, {
            BackgroundTransparency = 0
        })
        
        appearTween:Play()
        fadeTween:Play()
    else
        local disappearTween = tweenService:Create(detectionCircle, circleTweenInfo, {
            Size = UDim2.new(0, 0, 0, 0)
        })
        
        disappearTween:Play()
        disappearTween.Completed:Connect(function()
            detectionCircle.Visible = false
            detectionCircle.Size = UDim2.new(0, 150, 0, 150)
        end)
    end
end

